# FaithTech Blueprint - Environment Configuration
# Copy this file to .env and fill in your actual values for local development.
# For production, see config/production.env.example.

# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005

# ──────────────────────────────────────────────────────────────
# Frontend URL (used for email verification & password reset links)
# ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ──────────────────────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/faithtech-blueprint
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-local

# ──────────────────────────────────────────────────────────────
# JWT Authentication
# Generate a strong secret with: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ──────────────────────────────────────────────────────────────
# Admin Promotion Key (dev/initial setup only)
# ──────────────────────────────────────────────────────────────
ADMIN_PROMOTE_KEY=dev-promote-key

# ──────────────────────────────────────────────────────────────
# Email (SMTP) - via Mailtrap for dev
# ──────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your-mailtrap-username
EMAIL_PASSWORD=your-mailtrap-password
EMAIL_FROM=noreply@faithtech-blueprint.com

# ──────────────────────────────────────────────────────────────
# AWS (S3 for file uploads / templates)
# ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=faithtech-uploads

# ──────────────────────────────────────────────────────────────
# Stripe (payments)
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_XXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX

# ──────────────────────────────────────────────────────────────
# Sentry (error tracking)
# ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ──────────────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ──────────────────────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-session-secret

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TO_FILE=false

# ──────────────────────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────────────────────
ENABLE_ANALYTICS=true
ENABLE_INTEGRATIONS=true
ENABLE_BETA_FEATURES=false

# ──────────────────────────────────────────────────────────────
# CHMS Integrations
# ──────────────────────────────────────────────────────────────
PLANNING_CENTER_CLIENT_ID=your-pco-client-id
PLANNING_CENTER_CLIENT_SECRET=your-pco-client-secret
PLANNING_CENTER_REDIRECT_URI=http://localhost:3001/integrations/callback

BREEZE_API_KEY=your-breeze-api-key

CCB_API_KEY=your-ccb-api-key
CCB_API_SECRET=your-ccb-api-secret

# ──────────────────────────────────────────────────────────────
# Redis (caching) - optional
# ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────
# Frontend (React app) - used by client build
# ──────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_GA_MEASUREMENT_ID=